          </td>

        </tr>

      `;

      document
        .getElementById(
          "pits-note"
        )
        ?.classList.add(
          "hidden"
        );

      return;
    }

    let hasSpecialCondition =
      false;

    // ----------------------------------------------------------
    // ORDEN CRONOLÓGICO
    // ----------------------------------------------------------

    const sorted =
      [...pitStops]
        .sort(
          (a, b) => {

            const ta =
              timestamp(
                a.openf1Date ||
                a.date
              );

            const tb =
              timestamp(
                b.openf1Date ||
                b.date
              );

            return ta - tb;
          }
        );

    pitsTbody.innerHTML =
      sorted
        .map(
          p => {

            // --------------------------------------------------
            // FECHA REAL
            // --------------------------------------------------

            const pitDate =
              p.openf1Date ||
              p.date ||
              "";

            // --------------------------------------------------
            // VUELTA DEL PIT
            // --------------------------------------------------

            const pitLap =
              Number(
                p.lap
              );

            // --------------------------------------------------
            // ESTADO DE PISTA
            // --------------------------------------------------

            const state =
              getTrackStateAtLap(
                pitLap,
                intervals
              );

            if (
              state !== "GREEN"
            ) {

              hasSpecialCondition =
                true;
            }

            // --------------------------------------------------
            // STOP
            // --------------------------------------------------

            const stop =
              p.stop != null
                ? p.stop
                : "--";

            // --------------------------------------------------
            // LAP
            // --------------------------------------------------

            const lap =
              p.lap != null
                ? p.lap
                : "--";

            // --------------------------------------------------
            // DRIVER
            // --------------------------------------------------

            const driver =
              p.driverId ||
              p.driverNumber ||
              p.openf1DriverNumber ||
              "--";

            // --------------------------------------------------
            // DURACIÓN
            // --------------------------------------------------

            const duration =
              p.openf1PitDuration != null

                ? p.openf1PitDuration

                : p.duration;

            const durationText =
              formatPitDuration(
                duration
              );

            // --------------------------------------------------
            // COLOR DURACIÓN
            // --------------------------------------------------

            const durationClass =
              typeof duration === "number"

                ? "text-cyan-400 font-bold font-mono"

                : (

                  typeof duration === "string" &&
                  duration.includes(":")

                    ? "text-amber-400 font-bold font-mono"

                    : "text-cyan-400 font-bold font-mono"

                );

            // --------------------------------------------------
            // HORA (convertida a zona horaria del visitante)
            // --------------------------------------------------

            const time =
              p.openf1Date

                ? new Date(
                    p.openf1Date
                  ).toLocaleTimeString(
                    "es-ES",
                    {
                      hour:
                        "2-digit",

                      minute:
                        "2-digit",

                      second:
                        "2-digit"
                    }
                  )

                : p.time || "--";

            // --------------------------------------------------
            // RC
            // --------------------------------------------------

            const emoji =
              flagEmoji(
                state
              );

            const label =
              flagLabel(
                state
              );

            const rcClass =
              flagClass(
                state
              );

            return `

              <tr
                class="hover:bg-surface-container-high/40 transition-colors border-b border-border-subtle/30"
              >

                <td
                  class="py-2.5 px-3 text-center font-bold text-primary-container"
                >
                  #${stop}
                </td>

                <td
                  class="py-2.5 px-3 text-center font-bold text-on-surface"
                >
                  V${lap}
                </td>

                <td
                  class="py-2.5 px-3 font-semibold text-on-surface uppercase"
                >
                  ${driver}
                </td>

                <td
                  class="py-2.5 px-3 text-center text-xs ${durationClass}"
                >
                  ${durationText}
                </td>

                <td
                  class="py-2.5 px-3 text-center ${rcClass}"
                  title="${label}"
                >

                  <span
                    class="text-sm font-bold whitespace-nowrap"
                    aria-label="${label}"
                  >

                    ${emoji}
                    ${label}

                  </span>

                </td>

                <td
                  class="py-2.5 px-3 text-right text-xs text-on-surface-variant font-mono"
                >
                  ${time}
                </td>

              </tr>

            `;
          }
        )
        .join("");

    // ==========================================================
    // NOTA
    // ==========================================================

    const note =
      document.getElementById(
        "pits-note"
      );

    if (note) {

      note.textContent =
        "* RC se determina según la vuelta de la parada y la vuelta de inicio/fin del incidente: VERDE, VSC, SC o RED.";

      note.classList.toggle(
        "hidden",
        !hasSpecialCondition
      );
    }
  }

