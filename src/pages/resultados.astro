  function renderPits(
    pitStops,
    intervals
  ) {

    if (
      !pitStops ||
      pitStops.length === 0
    ) {

      pitsTbody.innerHTML = `

        <tr>

          <td
            colspan="6"
            class="py-12 text-center text-on-surface-variant"
          >

