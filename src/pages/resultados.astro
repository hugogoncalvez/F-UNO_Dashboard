---
import Layout from "../layouts/Layout.astro";
---

<Layout  title="Resultados de Carrera — Fórmula 1 2026"  description="Consulta los resultados oficiales de carrera, clasificación Q1/Q2/Q3 y paradas en boxes del Campeonato Mundial de Fórmula 1.">
<div class="space-y-8">
  <!-- ==========================================================         HEADER HERO    =========================================================== -->
  <div class="bg-panel-surface/80 border border-border-subtle rounded-2xl p-6 md:p-8 backdrop-blur-xl shadow-2xl space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span              id="hero-badge"              class="px-3 py-1 rounded-full bg-primary-container/20 border border-primary-container/40 text-primary text-xs font-bold uppercase tracking-wider"            >              Cargando...            </span>
          <span              id="hero-date"              class="text-xs text-on-surface-variant font-medium"            >
          </span>
        </div>
        <h1            id="hero-title"            class="text-display-lg font-bold text-on-surface uppercase tracking-tight"          >            Resultados de Carrera          </h1>
        <p            id="hero-subtitle"            class="text-base text-on-surface-variant font-body mt-1"          >            Cargando datos...          </p>
      </div>
      <!-- Selector -->
      <div          class="bg-surface-container border border-border-subtle rounded-xl p-3.5 flex flex-col gap-1 min-w-[240px]"        >
        <label            for="round-select"            class="text-[11px] font-label-caps text-on-surface-variant uppercase"          >            Seleccionar Gran Premio          </label>
        <select            id="round-select"            class="bg-transparent text-on-surface font-semibold text-sm outline-none cursor-pointer border-none"          >
          <option value="">              Cargando calendario...            </option>
        </select>
      </div>
    </div>
    <!-- PODIO -->
    <div        id="podium-section"        class="hidden grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-border-subtle/60"      >
      <!-- P2 -->
      <div          class="bg-surface-container-low/80 border border-border-subtle rounded-xl p-4 flex items-center gap-3"        >
        <div            class="w-10 h-10 rounded-xl bg-slate-400/20 border border-slate-400/40 text-slate-200 font-bold flex items-center justify-center text-lg"          >            2          </div>
        <div>
          <span              class="text-[10px] font-label-caps text-on-surface-variant uppercase"            >              2º Puesto            </span>
          <h3              id="podium-p2-name"              class="font-bold text-on-surface uppercase tracking-tight text-headline-sm"            >
          </h3>
          <span              id="podium-p2-team"              class="text-xs text-on-surface-variant"            >
          </span>
        </div>
      </div>
      <!-- P1 -->
      <div          class="bg-gradient-to-br from-primary-container/20 to-surface-container-low border border-primary-container/40 rounded-xl p-4 flex items-center gap-3 shadow-lg shadow-primary-container/10"        >
        <div            class="w-10 h-10 rounded-xl bg-amber-400/20 border border-amber-400/40 text-amber-400 font-bold flex items-center justify-center text-lg"          >            1          </div>
        <div>
          <span              class="text-[10px] font-label-caps text-amber-400 font-bold uppercase tracking-wider"            >              🏆 Ganador            </span>
          <h3              id="podium-p1-name"              class="font-bold text-on-surface uppercase tracking-tight text-headline-sm"            >
          </h3>
          <span              id="podium-p1-team"              class="text-xs text-primary"            >
          </span>
        </div>
      </div>
      <!-- P3 -->
      <div          class="bg-surface-container-low/80 border border-border-subtle rounded-xl p-4 flex items-center gap-3"        >
        <div            class="w-10 h-10 rounded-xl bg-amber-700/20 border border-amber-700/40 text-amber-500 font-bold flex items-center justify-center text-lg"          >            3          </div>
        <div>
          <span              class="text-[10px] font-label-caps text-on-surface-variant uppercase"            >              3º Puesto            </span>
          <h3              id="podium-p3-name"              class="font-bold text-on-surface uppercase tracking-tight text-headline-sm"            >
          </h3>
          <span              id="podium-p3-team"              class="text-xs text-on-surface-variant"            >
          </span>
        </div>
      </div>
    </div>
  </div>
  <!-- ==========================================================         TABS    =========================================================== -->
  <div class="space-y-6">
    <div        class="flex items-center gap-2 border-b border-border-subtle overflow-x-auto hide-scrollbar pb-2"      >
      <button          id="tab-btn-results"          class="px-5 py-2.5 rounded-xl font-bold text-sm transition-all bg-primary-container text-on-primary-container shadow-md"        >          🏁 Resultados de Carrera        </button>
      <button          id="tab-btn-pits"          class="px-5 py-2.5 rounded-xl font-medium text-sm transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-container"        >          🛠️ Paradas en Boxes        </button>
    </div>
    <!-- ========================================================           RESULTADOS      ========================================================= -->
    <div        id="tab-content-results"        class="bg-panel-surface/80 border border-border-subtle rounded-2xl p-6 backdrop-blur-xl shadow-2xl space-y-4"      >
      <div class="overflow-x-auto hide-scrollbar">
        <table            class="w-full text-left border-collapse min-w-[750px]"          >
          <thead>
            <tr                class="border-b border-border-subtle text-[11px] font-label-caps text-on-surface-variant uppercase bg-surface-container-low/50"              >
              <th class="py-3 px-3 text-center">                  Pos                </th>
              <th class="py-3 px-3">                  Piloto                </th>
              <th class="py-3 px-3">                  Equipo                </th>
              <th class="py-3 px-3 text-center">                  Salida                </th>
              <th class="py-3 px-3 text-center">                  Vueltas                </th>
              <th class="py-3 px-3">                  Tiempo / Estado                </th>
              <th class="py-3 px-3 text-center">                  Puntos                </th>
              <th class="py-3 px-3 text-right">                  Vuelta Rápida                </th>
            </tr>
          </thead>
          <tbody              id="results-tbody"              class="divide-y divide-border-subtle/50 text-sm font-data-tabular"            >
            <tr>
              <td                  colspan="8"                  class="py-12 text-center text-on-surface-variant"                >
                <span class="inline-block animate-pulse">                    Cargando resultados...                  </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <!-- ========================================================           BOXES      ========================================================= -->
    <div        id="tab-content-pits"        class="hidden bg-panel-surface/80 border border-border-subtle rounded-2xl p-6 backdrop-blur-xl shadow-2xl space-y-4"      >
      <div class="overflow-x-auto hide-scrollbar">
        <table            class="w-full text-left border-collapse min-w-[650px]"          >
          <thead>
            <tr                class="border-b border-border-subtle text-[11px] font-label-caps text-on-surface-variant uppercase bg-surface-container-low/50"              >
              <th class="py-3 px-3 text-center">                  Nº                </th>
              <th class="py-3 px-3 text-center">                  Vuelta                </th>
              <th class="py-3 px-3">                  Piloto                </th>
              <th class="py-3 px-3 text-center">                  Duración                </th>
              <th class="py-3 px-3 text-center">                  RC                </th>
              <th class="py-3 px-3 text-right">                  Hora                </th>
            </tr>
          </thead>
          <tbody              id="pits-tbody"              class="divide-y divide-border-subtle/50 text-sm font-data-tabular"            >
            <tr>
              <td                  colspan="6"                  class="py-12 text-center text-on-surface-variant"                >
                <span class="inline-block animate-pulse">                    Cargando paradas...                  </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p          id="pits-note"          class="text-xs text-on-surface-variant italic hidden"        >          * Duración afectada por interrupción de carrera.        </p>
    </div>
  </div>
</div>
</Layout>
<script>
  const BASE = "https://api.jolpi.ca/ergast/f1";
  const OPENF1 = "https://api.openf1.org/v1";

  // ============================================================
  // COLORES DE EQUIPOS
  // ============================================================

  const TEAM_COLORS = {
    "Red Bull Racing": "#3671c6",
    "McLaren": "#ff8000",
    "Ferrari": "#ef1a2d",
    "Mercedes": "#27f4d2",
    "Aston Martin": "#229971",
    "Alpine F1 Team": "#0093cc",
    "Williams": "#64c4ff",
    "Haas F1 Team": "#b6babd",
    "RB": "#6692ff",
    "Racing Bulls": "#6692ff",
    "Sauber": "#52e252",
    "Kick Sauber": "#52e252",
    "Audi": "#bb0000",
    "Cadillac": "#000000",
    "AlphaTauri": "#6692ff",
    "Alfa Romeo": "#c92d4b",
    "Racing Point": "#f596c8"
  };

  function teamColor(name) {

    const n =
      String(name || "").toLowerCase();

    for (
      const [key, value]
      of Object.entries(TEAM_COLORS)
    ) {

      const k =
        key.toLowerCase();

      if (
        n.includes(k) ||
        k.includes(n)
      ) {
        return value;
      }
    }

    return "#a1a1aa";
  }

  // ============================================================
  // FETCH
  // ============================================================

  async function fetchJson(url) {

    try {

      const res =
        await fetch(url);

      if (!res.ok) {

        console.error(
          `HTTP ${res.status}: ${url}`
        );

        return null;
      }

      return await res.json();

    } catch (error) {

      console.error(
        "Error fetch:",
        url,
        error
      );

      return null;
    }
  }

  // ============================================================
  // OPENF1 SESIONES
  // ============================================================

  let openf1Sessions = [];

  async function loadOpenF1Sessions() {

    if (
      openf1Sessions.length > 0
    ) {
      return;
    }

    const data =
      await fetchJson(
        `${OPENF1}/sessions?year=2026`
      );

    openf1Sessions =
      Array.isArray(data)
        ? data
        : [];
  }

  // ============================================================
  // NORMALIZAR
  // ============================================================

  function normalize(value) {

    return String(value ?? "")
      .trim()
      .toLowerCase();
  }

  // ============================================================
  // TIMESTAMP
  // ============================================================

  function timestamp(value) {

    if (!value) {
      return NaN;
    }

    const t =
      new Date(value).getTime();

    return Number.isFinite(t)
      ? t
      : NaN;
  }

  // ============================================================
  // BUSCAR SESIÓN RACE OPENF1
  // ============================================================

  function findSession(race) {

    const raceDate =
      String(
        race?.date || ""
      );

    const country =
      normalize(
        race?.Circuit?.Location?.country
      );

    const circuit =
      normalize(
        race?.Circuit?.circuitName
      );

    const races =
      openf1Sessions.filter(
        s =>
          normalize(
            s.session_type
          ) === "race" ||

          normalize(
            s.session_name
          ) === "race"
      );

    // ----------------------------------------------------------
    // 1. FECHA + PAÍS
    // ----------------------------------------------------------

    let match =
      races.find(
        s => {

          const sDate =
            String(
              s.date_start || ""
            ).slice(0, 10);

          return (
            sDate === raceDate &&
            normalize(
              s.country_name
            ) === country
          );
        }
      );

    if (match) {
      return match;
    }

    // ----------------------------------------------------------
    // 2. CIRCUITO + PAÍS
    // ----------------------------------------------------------

    match =
      races.find(
        s => {

          const sCircuit =
            normalize(
              s.circuit_short_name
            );

          const sameCountry =
            normalize(
              s.country_name
            ) === country;

          return (
            sameCountry &&
            (
              circuit.includes(
                sCircuit
              ) ||

              sCircuit.includes(
                circuit
              )
            )
          );
        }
      );

    if (match) {
      return match;
    }

    // ----------------------------------------------------------
    // 3. SOLO FECHA
    // ----------------------------------------------------------

    match =
      races.find(
        s => {

          const sDate =
            String(
              s.date_start || ""
            ).slice(0, 10);

          return (
            sDate === raceDate
          );
        }
      );

    return match || null;
  }

  // ============================================================
  // OPENF1 PIT
  // ============================================================

  async function getOpenF1Pits(
    sessionKey
  ) {

    const data =
      await fetchJson(
        `${OPENF1}/pit?session_key=${sessionKey}`
      );

    return Array.isArray(data)
      ? data
      : [];
  }

  // ============================================================
  // OPENF1 RACE CONTROL
  // ============================================================

  async function getOpenF1RaceControl(
    sessionKey
  ) {

    const data =
      await fetchJson(
        `${OPENF1}/race_control?session_key=${sessionKey}`
      );

    return Array.isArray(data)
      ? data
      : [];
  }

  // ============================================================
  // TEXTO RC
  // ============================================================

  function rcText(rc) {

    return [

      rc?.category,
      rc?.flag,
      rc?.scope,
      rc?.message,
      rc?.status

    ]
      .map(normalize)
      .filter(Boolean)
      .join(" ");
  }

  // ============================================================
  // OBTENER VUELTA DEL EVENTO
  // ============================================================

  function getEventLap(rc) {

    const lap =
      Number(
        rc?.lap_number
      );

    return Number.isFinite(lap)
      ? lap
      : NaN;
  }

  // ============================================================
  // RED FLAG - INICIO
  // ============================================================

  function isRedFlagStart(rc) {

    const text =
      rcText(rc);

    return (

      normalize(
        rc?.flag
      ) === "red" ||

      text.includes(
        "red flag"
      ) ||

      text.includes(
        "redflag"
      )
    );
  }

  // ============================================================
  // RED FLAG - FIN
  // ============================================================

  function isRedFlagEnd(rc) {

    const text =
      rcText(rc);

    return (

      normalize(
        rc?.flag
      ) === "green" ||

      text.includes(
        "green flag"
      ) ||

      text.includes(
        "race resumed"
      ) ||

      text.includes(
        "race restart"
      ) ||

      text.includes(
        "restarting"
      ) ||

      text.includes(
        "standing start"
      ) ||

      text.includes(
        "rolling start"
      ) ||

      text.includes(
        "session resumed"
      )
    );
  }

  // ============================================================
  // SAFETY CAR - INICIO
  //
  // "SAFETY CAR LIGHTS ON"
  // NO significa que el SC esté desplegado.
  // ============================================================

  function isSafetyCarStart(rc) {

    const text =
      rcText(rc);

    if (
      text.includes(
        "safety car lights on"
      )
    ) {

      return false;
    }

    if (
      text.includes(
        "safety car deployed"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car deployment"
      )
    ) {

      return true;
    }

    if (
      normalize(
        rc?.category
      ) === "safetycar" &&

      (
        text.includes(
          "deployed"
        ) ||

        text.includes(
          "deployment"
        )
      )
    ) {

      return true;
    }

    return false;
  }

  // ============================================================
  // SAFETY CAR - FIN
  //
  // IMPORTANTE:
  //
  // El SC puede terminar mediante:
  //
  // - Safety Car In
  // - Safety Car Ending
  // - Safety Car Period Ended
  // - Safety Car Withdrawn
  // - Green Flag
  // - Race Resumed
  // - Restart
  //
  // PERO solamente se utiliza como FIN si existe
  // un SC actualmente abierto.
  // ============================================================

  function isSafetyCarEnd(rc) {

    const text =
      rcText(rc);

    if (
      text.includes(
        "safety car in"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car ending"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car period ended"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car withdrawn"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car returning"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "safety car has returned"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "green flag"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "race resumed"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "restart"
      )
    ) {

      return true;
    }

    return false;
  }

  // ============================================================
  // VSC - INICIO
  // ============================================================

  function isVSCStart(rc) {

    const text =
      rcText(rc);

    return (

      text.includes(
        "virtual safety car deployed"
      ) ||

      text.includes(
        "virtual safety car deployment"
      ) ||

      text.includes(
        "vsc deployed"
      ) ||

      text.includes(
        "vsc deployment"
      ) ||

      (
        text.includes(
          "virtual safety car"
        ) &&

        (
          text.includes(
            "active"
          ) ||

          text.includes(
            "deployed"
          )
        )
      )
    );
  }

  // ============================================================
  // VSC - FIN
  //
  // Igual que SC:
  // el final se considera en la vuelta del evento END.
  //
  // Si:
  //
  // VSC START = V55
  // VSC END   = V57
  //
  // entonces:
  //
  // V55 = VSC
  // V56 = VSC
  // V57 = VERDE
  //
  // ============================================================

  function isVSCEnd(rc) {

    const text =
      rcText(rc);

    if (
      text.includes(
        "vsc ending"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "vsc ends"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "vsc period ended"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "virtual safety car ending"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "virtual safety car ends"
      )
    ) {

      return true;
    }

    if (
      text.includes(
        "virtual safety car period ended"
      )
    ) {

      return true;
    }

    return false;
  }

  // ============================================================
  // ESTADOS
  // ============================================================

  const TRACK_STATES = [
    "GREEN",
    "SC",
    "VSC",
    "RED"
  ];

  // ============================================================
  // CONSTRUIR INTERVALOS ESPECIALES
  //
  // La referencia PRINCIPAL es la vuelta del PIT.
  //
  // Fórmula:
  //
  // startLap <= pitLap < endLap
  //
  // Por lo tanto, la vuelta END ya es VERDE.
  // ============================================================

  function buildSpecialIntervals(
    raceControl
  ) {

    const events =
      [...raceControl]
        .map(
          rc => ({

            rc,

            ts:
              timestamp(
                rc?.date
              ),

            lap:
              getEventLap(rc)

          })
        )
        .filter(
          x =>
            Number.isFinite(
              x.ts
            )
        )
        .sort(
          (a, b) => {

            if (
              a.ts !== b.ts
            ) {

              return a.ts - b.ts;
            }

            // Si dos eventos tienen exactamente
            // el mismo timestamp, conservamos
            // el orden original.
            return 0;
          }
        );

    const intervals = [];

    let redStart = null;
    let scStart = null;
    let vscStart = null;

    // ----------------------------------------------------------
    // RECORRER RACE CONTROL
    // ----------------------------------------------------------

    for (
      const item
      of events
    ) {

      const rc =
        item.rc;

      const ts =
        item.ts;

      const lap =
        item.lap;

      // ========================================================
      // 1. RED FLAG - START
      // ========================================================

      if (
        isRedFlagStart(rc)
      ) {

        if (
          redStart === null &&
          Number.isFinite(lap)
        ) {

          redStart = {

            lap,
            ts,
            source: rc

          };
        }

        // Una RED domina cualquier otra condición.
        continue;
      }

      // ========================================================
      // 2. RED FLAG - END
      // ========================================================

      if (
        redStart !== null &&
        isRedFlagEnd(rc)
      ) {

        const endLap =
          Number.isFinite(lap)
            ? lap
            : Infinity;

        intervals.push({

          state: "RED",

          startLap:
            redStart.lap,

          endLap,

          startTs:
            redStart.ts,

          endTs:
            ts,

          sourceStart:
            redStart.source,

          sourceEnd:
            rc

        });

        redStart = null;

        continue;
      }

      // ========================================================
      // 3. SI HAY VSC ABIERTO, PRIMERO BUSCAMOS SU FIN
      // ========================================================

      if (
        vscStart !== null &&
        isVSCEnd(rc)
      ) {

        const endLap =
          Number.isFinite(lap)
            ? lap
            : Infinity;

        intervals.push({

          state: "VSC",

          startLap:
            vscStart.lap,

          endLap,

          startTs:
            vscStart.ts,

          endTs:
            ts,

          sourceStart:
            vscStart.source,

          sourceEnd:
            rc

        });

        vscStart = null;

        continue;
      }

      // ========================================================
      // 4. SI HAY SC ABIERTO, PRIMERO BUSCAMOS SU FIN
      // ========================================================

      if (
        scStart !== null &&
        isSafetyCarEnd(rc)
      ) {

        const endLap =
          Number.isFinite(lap)
            ? lap
            : Infinity;

        intervals.push({

          state: "SC",

          startLap:
            scStart.lap,

          endLap,

          startTs:
            scStart.ts,

          endTs:
            ts,

          sourceStart:
            scStart.source,

          sourceEnd:
            rc

        });

        scStart = null;

        continue;
      }

      // ========================================================
      // 5. VSC - START
      // ========================================================

      if (
        isVSCStart(rc)
      ) {

        if (
          vscStart === null &&
          Number.isFinite(lap)
        ) {

          vscStart = {

            lap,
            ts,
            source: rc

          };
        }

        continue;
      }

      // ========================================================
      // 6. SC - START
      // ========================================================

      if (
        isSafetyCarStart(rc)
      ) {

        if (
          scStart === null &&
          Number.isFinite(lap)
        ) {

          scStart = {

            lap,
            ts,
            source: rc

          };
        }

        continue;
      }
    }

    // ==========================================================
    // INTERVALOS ABIERTOS
    // ==========================================================

    if (
      redStart !== null
    ) {

      intervals.push({

        state: "RED",

        startLap:
          redStart.lap,

        endLap:
          Infinity,

        startTs:
          redStart.ts,

        endTs:
          Infinity,

        sourceStart:
          redStart.source,

        sourceEnd:
          null

      });
    }

    if (
      scStart !== null
    ) {

      intervals.push({

        state: "SC",

        startLap:
          scStart.lap,

        endLap:
          Infinity,

        startTs:
          scStart.ts,

        endTs:
          Infinity,

        sourceStart:
          scStart.source,

        sourceEnd:
          null

      });
    }

    if (
      vscStart !== null
    ) {

      intervals.push({

        state: "VSC",

        startLap:
          vscStart.lap,

        endLap:
          Infinity,

        startTs:
          vscStart.ts,

        endTs:
          Infinity,

        sourceStart:
          vscStart.source,

        sourceEnd:
          null

      });
    }

    return intervals.sort(
      (a, b) =>
        a.startLap -
        b.startLap
    );
  }

  // ============================================================
  // ESTADO EXACTO EN UNA PARADA
  //
  // IMPORTANTE:
  //
  // RED > VSC > SC > GREEN
  //
  // Y:
  //
  // startLap <= pitLap < endLap
  //
  // La vuelta END ya es VERDE.
  // ============================================================

  function getTrackStateAtLap(
    pitLap,
    intervals
  ) {

    const lap =
      Number(pitLap);

    if (
      !Number.isFinite(lap)
    ) {

      return "GREEN";
    }

    // ----------------------------------------------------------
    // RED
    // ----------------------------------------------------------

    const red =
      intervals.find(
        interval =>

          interval.state === "RED" &&

          lap >=
            interval.startLap &&

          lap <
            interval.endLap
      );

    if (red) {
      return "RED";
    }

    // ----------------------------------------------------------
    // VSC
    // ----------------------------------------------------------

    const vsc =
      intervals.find(
        interval =>

          interval.state === "VSC" &&

          lap >=
            interval.startLap &&

          lap <
            interval.endLap
      );

    if (vsc) {
      return "VSC";
    }

    // ----------------------------------------------------------
    // SC
    // ----------------------------------------------------------

    const sc =
      intervals.find(
        interval =>

          interval.state === "SC" &&

          lap >=
            interval.startLap &&

          lap <
            interval.endLap
      );

    if (sc) {
      return "SC";
    }

    // ----------------------------------------------------------
    // TODO LO DEMÁS
    // ----------------------------------------------------------

    return "GREEN";
  }

  // ============================================================
  // PRESENTACIÓN RC
  // ============================================================

  function flagEmoji(state) {

    switch (state) {

      case "RED":
        return "🔴";

      case "VSC":
        return "🟠";

      case "SC":
        return "🟠";

      case "GREEN":
      default:
        return "🟢";
    }
  }

  // ============================================================
  // LABEL RC
  // ============================================================

  function flagLabel(state) {

    switch (state) {

      case "RED":
        return "RED";

      case "VSC":
        return "VSC";

      case "SC":
        return "SC";

      case "GREEN":
      default:
        return "VERDE";
    }
  }

  // ============================================================
  // CLASE RC
  // ============================================================

  function flagClass(state) {

    switch (state) {

      case "RED":
        return "text-red-400";

      case "VSC":
        return "text-orange-400";

      case "SC":
        return "text-orange-400";

      case "GREEN":
      default:
        return "text-emerald-400";
    }
  }

  // ============================================================
  // FORMATEAR DURACIÓN
  // ============================================================

  function formatPitDuration(
    duration
  ) {

    if (
      duration === null ||
      duration === undefined ||
      duration === ""
    ) {

      return "--";
    }

    // ----------------------------------------------------------
    // OPENF1
    // ----------------------------------------------------------

    if (
      typeof duration === "number" &&
      Number.isFinite(duration)
    ) {

      if (
        duration < 60
      ) {

        return (
          `${duration.toFixed(3)} s`
        );
      }

      const minutes =
        Math.floor(
          duration / 60
        );

      const seconds =
        duration -
        (
          minutes * 60
        );

      return (
        `${minutes}m ` +
        `${seconds.toFixed(3).padStart(6, "0")}s`
      );
    }

    // ----------------------------------------------------------
    // JOLPICA
    // ----------------------------------------------------------

    return String(duration);
  }

