  // ============================================================
  // ENCONTRAR PIT OPENF1
  // ============================================================

  function findOpenF1Pit(
    jolpicaPit,
    openf1Pits
  ) {

    const driverId =
      normalize(
        jolpicaPit.driverId
      );

    const driverNumber =
      DRIVER_NUMBERS[
        driverId
      ];

    const lap =
      Number(
        jolpicaPit.lap
      );

    if (
      !driverNumber ||
      !Number.isFinite(lap)
    ) {

      return null;
    }

    const matches =
      openf1Pits.filter(
        op =>

          Number(
            op.driver_number
          ) === driverNumber &&

          Number(
            op.lap_number
          ) === lap
      );

    if (
      matches.length === 0
    ) {

      return null;
    }

    if (
      matches.length === 1
    ) {

      return matches[0];
    }

    // ----------------------------------------------------------
    // VARIAS COINCIDENCIAS
    // ----------------------------------------------------------

    const jpTime =
      timestamp(
        jolpicaPit.date
      );

    if (
      !Number.isFinite(jpTime)
    ) {

      return matches[0];
    }

    return (

      [...matches]
        .sort(
          (a, b) => {

            const ta =
              timestamp(
                a.date
              );

            const tb =
              timestamp(
                b.date
              );

            return (

              Math.abs(
                ta - jpTime
              ) -

              Math.abs(
                tb - jpTime
              )

            );
          }
        )[0]

      ||

      null
    );
  }

