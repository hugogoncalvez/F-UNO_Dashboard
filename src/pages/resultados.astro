  // ============================================================
  // CARGAR RONDA
  // ============================================================

  async function loadRound(
    round
  ) {

    setLoading();

    // ==========================================================
    // JOLPICA
    // ==========================================================

    const [
      raceJson,
      pitsJson
    ] =
      await Promise.all([

        fetchJson(
          `${BASE}/2026/${round}/results.json`
        ),

        fetchJson(
          `${BASE}/2026/${round}/pitstops.json?limit=100`
        )

      ]);

    const race =
      raceJson
        ?.MRData
        ?.RaceTable
        ?.Races?.[0];

    const pitsRace =
      pitsJson
        ?.MRData
        ?.RaceTable
        ?.Races?.[0];

    // ==========================================================
    // HEADER
    // ==========================================================

    if (race) {

      heroBadge.textContent =
        `Ronda ${race.round} · 2026`;

      heroDate.textContent =
        race.date ?? "";

      heroTitle.textContent =
        race.raceName;

      heroSubtitle.textContent =
        `${race.Circuit?.circuitName} — ` +
        `${race.Circuit?.Location?.locality}, ` +
        `${race.Circuit?.Location?.country}`;

    } else {

      heroBadge.textContent =
        `Ronda ${round} · 2026`;

      heroTitle.textContent =
        "Gran Premio";

      heroSubtitle.textContent =
        "No hay datos disponibles.";
    }

    // ==========================================================
    // PODIO
    // ==========================================================

    const results =
      race?.Results ?? [];

    if (
      results.length >= 3
    ) {

      podiumP1Name.textContent =
        `${results[0].Driver.givenName} ${results[0].Driver.familyName}`;

      podiumP1Team.textContent =
        results[0].Constructor.name;

      podiumP2Name.textContent =
        `${results[1].Driver.givenName} ${results[1].Driver.familyName}`;

      podiumP2Team.textContent =
        results[1].Constructor.name;

      podiumP3Name.textContent =
        `${results[2].Driver.givenName} ${results[2].Driver.familyName}`;

      podiumP3Team.textContent =
        results[2].Constructor.name;

      podiumSection.classList.remove(
        "hidden"
      );
    }

    renderResults(
      results
    );

    // ==========================================================
    // PIT STOPS JOLPICA
    // ==========================================================

    let pitStops =
      pitsRace?.PitStops ?? [];

    let raceControl = [];

    let intervals = [];

    // ==========================================================
    // OPENF1
    // ==========================================================

    await loadOpenF1Sessions();

    if (race) {

      const session =
        findSession(
          race
        );

      if (session) {

        console.log(
          "OpenF1 session:",
          session
        );

        const [
          openf1Pits,
          openf1RC
        ] =
          await Promise.all([

            getOpenF1Pits(
              session.session_key
            ),

            getOpenF1RaceControl(
              session.session_key
            )

          ]);

        raceControl =
          openf1RC;

        // ======================================================
        // DEBUG RACE CONTROL
        // ======================================================

        debugSpecialRaceControl(
          raceControl
        );

        // ======================================================
        // CONSTRUIR INTERVALOS
        // ======================================================

        intervals =
          buildSpecialIntervals(
            raceControl
          );

        debugIntervals(
          intervals
        );

        // ======================================================
        // CRUZAR JOLPICA + OPENF1
        // ======================================================

        pitStops =
          pitStops.map(
            jp => {

              const op =
                findOpenF1Pit(
                  jp,
                  openf1Pits
                );

              return {

                ...jp,

                openf1DriverNumber:
                  op?.driver_number ??
                  DRIVER_NUMBERS[
                    normalize(
                      jp.driverId
                    )
                  ] ??
                  null,

                openf1Date:
                  op?.date ??
                  null,

                openf1PitDuration:
                  op?.pit_duration ??
                  null
              };
            }
          );

        // ======================================================
        // DEBUG PARADAS
        // ======================================================

        debugPits(
          pitStops,
          intervals
        );

      } else {

        console.warn(
          "No se encontró sesión Race en OpenF1."
        );
      }
    }

    // ==========================================================
    // DEBUG FINAL
    // ==========================================================

    console.log(
      "===================================="
    );

    console.log(
      `ROUND ${round}`
    );

    console.log(
      "Pit stops finales:",
      pitStops
    );

    console.log(
      "Intervalos especiales:",
      intervals
    );

    console.log(
      "===================================="
    );

    // ==========================================================
    // RENDER
    // ==========================================================

    renderPits(
      pitStops,
      intervals
    );
  }

  // ============================================================
  // INIT
  // ============================================================

  async function init() {

    const calJson =
      await fetchJson(
        `${BASE}/2026/races.json`
      );

    const races =
      calJson
        ?.MRData
        ?.RaceTable
        ?.Races ?? [];

    const now =
      Date.now();

    const pastRounds = [];

    if (
      races.length > 0
    ) {

      roundSelect.innerHTML =
        races
          .map(
            r => {

              const startUtc =
                new Date(
                  `${r.date}T${r.time ?? "00:00:00"}`
                ).getTime();

              const isPast =
                startUtc +
                3 * 3600_000 <
                now;

              if (
                isPast
              ) {

                pastRounds.push(
                  Number(
                    r.round
                  )
                );
              }

              return `

                <option
                  value="${r.round}"
                  class="bg-panel-surface text-on-surface"
                >

                  R${r.round}: ${r.raceName}

                  ${
                    isPast
                      ? " ✓"
                      : " (Próxima)"
                  }

                </option>

              `;
            }
          )
          .join("");
    }

    // ==========================================================
    // URL
    // ==========================================================

    const params =
      new URLSearchParams(
        window.location.search
      );

    const urlRound =
      params.get(
        "round"
      );

    const selectedRound =
      urlRound

        ? Number(
            urlRound
          )

        : (

          pastRounds.length > 0

            ? pastRounds[
                pastRounds.length - 1
              ]

            : 1

        );

    roundSelect.value =
      String(
        selectedRound
      );

    await loadRound(
      selectedRound
    );

    // ==========================================================
    // CAMBIO DE RONDA
    // ==========================================================

    roundSelect.addEventListener(
      "change",
      async () => {

        const newRound =
          Number(
            roundSelect.value
          );

        const url =
          new URL(
            window.location.href
          );

        url.searchParams.set(
          "round",
          String(
            newRound
          )
        );

        window.history.pushState(
          {},
          "",
          url.toString()
        );

        await loadRound(
          newRound
        );
      }
    );
  }

  // ============================================================
  // START
  // ============================================================

  init();

</script>