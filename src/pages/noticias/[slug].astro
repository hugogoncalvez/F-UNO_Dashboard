---
import Layout from "../../layouts/Layout.astro";
import { getProcessedNewsBySlug, getProcessedNewsList } from "../../lib/news";
import type { ProcessedNewsItem } from "../../lib/types";

export async function getStaticPaths() {
  const news = getProcessedNewsList(100);
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: ProcessedNewsItem };

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

const categoryColors: Record<string, string> = {
  Carrera: "#e10600",
  Piloto: "#FF8000",
  Equipo: "#3671C6",
  Técnica: "#27F4D2",
  Reglamento: "#64C4FF",
  "Off-track": "#B6BABD",
};

const accentColor = categoryColors[item.category] ?? item.teamColor;
---

<Layout title={`${item.title} · F-Uno Center`} description={item.summary}>
  <!-- Hero -->
  <div class="relative w-full h-56 sm:h-72 md:h-80 rounded-2xl overflow-hidden mb-8 border border-border-subtle"
    style={`background: linear-gradient(135deg, ${item.teamColor}66 0%, ${item.teamColor}22 50%, ${item.teamColor}0a 100%);`}
  >
    <div class="absolute inset-0 bg-gradient-to-t from-carbon-bg via-carbon-bg/60 to-transparent" />
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-3">
        <span
          class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border"
          style={`background: ${accentColor}22; color: ${accentColor}; border-color: ${accentColor}44;`}
        >
          {item.category}
        </span>
        <span class="text-xs text-zinc-400">{item.source}</span>
        <span class="text-xs text-zinc-500">·</span>
        <time class="text-xs text-zinc-400">{formatDate(item.date)}</time>
      </div>
      <h1 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white leading-tight">
        {item.title}
      </h1>
    </div>
  </div>

  <!-- Summary -->
  <p class="text-lg text-zinc-300 mb-6 leading-relaxed border-l-4 pl-4" style={`border-color: ${accentColor};`}>
    {item.summary}
  </p>

  <!-- Content -->
  <article class="prose prose-invert prose-zinc max-w-none mb-8
    prose-headings:font-display prose-headings:text-white
    prose-p:text-zinc-300 prose-p:leading-relaxed
    prose-strong:text-white prose-em:text-zinc-200
    prose-a:text-primary-container hover:prose-a:text-f1-red
    prose-li:text-zinc-300">
    <Fragment set:html={item.content} />
  </article>

  <!-- Key Points -->
  {
    item.keyPoints && item.keyPoints.length > 0 && (
      <div class="bg-panel-surface border border-border-subtle rounded-xl p-5 mb-8">
        <h3 class="font-display text-sm uppercase tracking-widest text-zinc-400 mb-3">
          Puntos Clave
        </h3>
        <ul class="space-y-2">
          {item.keyPoints.map((point) => (
            <li class="flex items-start gap-2 text-sm text-zinc-300">
              <span class="material-symbols-outlined text-base mt-0.5" style={`color: ${accentColor};`}>check_circle</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Attribution & Source -->
  <div class="border-t border-border-subtle pt-6 mt-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-zinc-500">
        Este artículo fue generado a partir de hechos reportados por fuentes públicas.
        Basado en reportes de {item.source}.
      </p>
      <a
        href={item.originalLink}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-4 py-2 rounded-lg bg-surface-container-low border border-border-subtle text-sm text-zinc-400 hover:text-white hover:border-primary-container transition-colors flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-[16px]">open_in_new</span>
        Ver noticia original
      </a>
    </div>
  </div>

  <!-- Back -->
  <div class="mt-8">
    <a
      href="/noticias"
      class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-f1-red transition-colors"
    >
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Volver a noticias
    </a>
  </div>
</Layout>
