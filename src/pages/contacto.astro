---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto · F-Uno Center" description="Contactanos para consultas, sugerencias o collaboraciones.">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 border-b border-border-subtle pb-4">
      <h1 class="font-display text-4xl font-bold text-text-primary uppercase tracking-tighter">Contacto</h1>
      <p class="text-text-secondary mt-1">¿Tenés una consulta, sugerencia o querés colaborar?</p>
    </div>

    <div class="bg-panel-surface border border-border-subtle rounded-2xl p-8 text-center space-y-6">
      <span class="material-symbols-outlined text-6xl text-primary-container">mail</span>
      <div class="space-y-2">
        <h2 class="font-display text-xl text-text-primary">Escribinos</h2>
        <p class="text-text-secondary text-sm">Respondemos lo antes posible.</p>
      </div>
      <a
        href="mailto:centerfuno@gmail.com?subject=Contacto%20-%20F-Uno%20Center"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-container text-carbon-bg font-bold uppercase tracking-wider text-sm hover:opacity-90 transition-opacity"
      >
        <span class="material-symbols-outlined text-[18px]">open_in_new</span>
        Enviar email
      </a>
      <p class="text-text-secondary text-xs">centerfuno@gmail.com</p>
    </div>
  </div>
</Layout>
