---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contacto · F-Uno Center"
  description="Contactanos para consultas, sugerencias o colaboraciones."
>
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 border-b border-border-subtle pb-4">
      <h1
        class="font-display text-4xl font-bold text-text-primary uppercase tracking-tighter"
      >
        Contacto
      </h1>
      <p class="text-text-secondary mt-1">¿Tenés una consulta o sugerencia?</p>
    </div>

    <div
      class="bg-panel-surface border border-border-subtle rounded-2xl p-8 text-center space-y-6"
    >
      <span class="material-symbols-outlined text-6xl text-primary-container"
        >mail</span
      >
      <div class="space-y-2">
        <h2 class="font-display text-xl text-text-primary">Escribinos</h2>
        <p class="text-text-secondary text-sm">Respondemos lo antes posible.</p>
      </div>
      <div
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-container-low border border-border-subtle"
      >
        <span id="email-text" class="text-text-primary font-mono text-sm"
          >centerfuno@gmail.com</span
        >
        <button
          id="copy-btn"
          type="button"
          class="text-on-surface-variant hover:text-primary-container transition-colors"
          title="Copiar email"
        >
          <span class="material-symbols-outlined text-[18px]">content_copy</span
          >
        </button>
      </div>
      <p id="copy-msg" class="text-primary-container text-xs hidden">
        ¡Copiado!
      </p>
    </div>
  </div>

  <script>
    document.getElementById("copy-btn")?.addEventListener("click", async () => {
      const email = document.getElementById("email-text")?.textContent?.trim();
      if (!email) return;
      await navigator.clipboard.writeText(email);
      const msg = document.getElementById("copy-msg");
      msg?.classList.remove("hidden");
      setTimeout(() => msg?.classList.add("hidden"), 2000);
    });
  </script>
</Layout>
