---
import Layout from "../layouts/Layout.astro";
import CalendarList from "../components/CalendarList.astro";
import { getSeasonCalendar } from "../lib/jolpica";

const year = new Date().getFullYear();
const races = await getSeasonCalendar(year);
---

<Layout title="Calendario F1 {year} · F-Uno Center" description={`Calendario de la temporada ${year} de Formula 1 con resultados.`}>
  <h1 class="font-display text-4xl font-bold text-white mb-2">Calendario {year}</h1>
  <p class="text-zinc-400 mb-6">
    Todas las rondas de la temporada con estado y podio de las carreras disputadas.
  </p>
  <CalendarList races={races} />
</Layout>
