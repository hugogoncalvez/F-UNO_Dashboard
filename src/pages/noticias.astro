---
import Layout from "../layouts/Layout.astro";
import NewsGrid from "../components/NewsGrid.astro";
import { getNews } from "../lib/news";

const allNews = await getNews(30);
---

<Layout title="Noticias F1 · F-Uno Center" description="Últimas noticias de Formula 1 procesadas con IA, originales y de fuentes verificadas.">
  <div class="mb-8 border-b border-border-subtle pb-4">
    <h1 class="font-display text-4xl font-bold text-text-primary uppercase tracking-tighter">Últimas Noticias</h1>
    <p class="text-text-secondary mt-1">
      Artículos originales generados a partir de fuentes verificadas.
    </p>
  </div>

  <NewsGrid items={allNews} cols={3} />
</Layout>
