---
import Layout from "../layouts/Layout.astro";
import NewsGrid from "../components/NewsGrid.astro";
import { getNews, getProcessedNewsList } from "../lib/news";

const [allNews, processed] = await Promise.all([
  getNews(30),
  Promise.resolve(getProcessedNewsList(30)),
]);

const featuredNews = allNews.length > 0 ? allNews[0] : null;
const restNews = allNews.length > 1 ? allNews.slice(1) : [];

function timeAgo(date: string | null): string {
  if (!date) return "";
  const then = new Date(date).getTime();
  if (Number.isNaN(then)) return "";
  const mins = Math.floor((Date.now() - then) / 60000);
  if (mins < 1) return "Ahora mismo";
  if (mins < 60) return `Hace ${mins} min`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `Hace ${hours} h`;
  const days = Math.floor(hours / 24);
  return `Hace ${days} d`;
}

// Get processed item for featured news to access team data
const featuredProcessed = featuredNews?.link.startsWith("/noticias/")
  ? processed.find(p => p.slug === featuredNews.link.replace("/noticias/", ""))
  : null;

const teamColor = featuredProcessed?.teamColor ?? "#e10600";
const teamImage = featuredProcessed?.teamImage ?? null;
const category = featuredProcessed?.category ?? null;

const categoryColors: Record<string, string> = {
  Carrera: "#e10600",
  Piloto: "#FF8000",
  Equipo: "#3671C6",
  Técnica: "#27F4D2",
  Reglamento: "#64C4FF",
  "Off-track": "#B6BABD",
};
---

<Layout title="Noticias F1 · F-Uno Center" description="Últimas noticias de Formula 1 procesadas con IA, originales y de fuentes verificadas.">
  <div class="mb-8 border-b border-border-subtle pb-4">
    <h1 class="font-display text-4xl font-bold text-text-primary uppercase tracking-tighter">Últimas Noticias</h1>
    <p class="text-text-secondary mt-1">
      Artículos originales generados a partir de fuentes verificadas.
    </p>
  </div>

  {
    featuredNews ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        <a
          href={featuredNews.link}
          class:list={[
            "md:col-span-2 md:row-span-2 group bg-panel-surface border border-border-subtle rounded-2xl overflow-hidden hover:scale-[1.01] transition-transform duration-300 flex flex-col cursor-pointer relative shadow-[0_0_15px_rgba(0,0,0,0.5)]",
            featuredNews.link.startsWith("/noticias") ? "" : "target=_blank rel=noopener noreferrer",
          ]}
        >
          {
            teamImage ? (
              <img src={teamImage} alt={featuredNews.title} class="h-64 md:h-full w-full object-cover absolute inset-0 z-0 opacity-60 group-hover:opacity-80 transition-opacity duration-300" />
            ) : (
              <div
                class="h-64 md:h-full w-full absolute inset-0 z-0 opacity-60 group-hover:opacity-80 transition-opacity duration-300 flex items-center justify-center"
                style={`background: linear-gradient(135deg, ${teamColor}44 0%, ${teamColor}11 100%);`}
              >
                <span class="material-symbols-outlined text-border-subtle text-8xl">newspaper</span>
              </div>
            )
          }
          
          <div class="absolute inset-0 bg-gradient-to-t from-carbon-bg via-carbon-bg/80 to-transparent z-10"></div>
          
          <div class="relative z-20 p-6 flex flex-col gap-3 flex-grow justify-end h-full min-h-[350px]">
            <div class="flex justify-between items-center text-xs font-bold tracking-widest text-primary-container uppercase mb-2">
              <span class="flex items-center gap-1 bg-surface-container/80 px-2 py-0.5 rounded backdrop-blur-sm border border-border-subtle">
                <span class="material-symbols-outlined text-[14px]">bolt</span>
                {featuredNews.source}
              </span>
              {featuredNews.date && <span class="text-text-secondary bg-carbon-bg/60 px-2 py-0.5 rounded backdrop-blur-sm">{timeAgo(featuredNews.date)}</span>}
            </div>
            {category && (
              <span
                class="self-start px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border"
                style={`background: ${(categoryColors[category] ?? teamColor)}22; color: ${categoryColors[category] ?? teamColor}; border-color: ${(categoryColors[category] ?? teamColor)}44;`}
              >
                {category}
              </span>
            )}
            <h3 class="font-display text-3xl sm:text-4xl text-text-primary leading-none uppercase drop-shadow-lg group-hover:text-primary transition-colors">
              {featuredNews.title}
            </h3>
            {featuredNews.description && (
              <p class="text-sm text-on-surface mt-2 max-w-2xl drop-shadow line-clamp-3">
                {featuredNews.description}
              </p>
            )}
          </div>
        </a>

        <div class="contents">
          {restNews.slice(0, 2).map((item) => {
            const processedItem = item.link.startsWith("/noticias/")
              ? processed.find(p => p.slug === item.link.replace("/noticias/", ""))
              : null;
            const img = processedItem?.teamImage ?? item.imageUrl;
            const tColor = processedItem?.teamColor ?? "#e10600";
            const cat = processedItem?.category;
            const isInternal = item.link.startsWith("/noticias");

            return (
              <a
                href={item.link}
                class:list={[
                  "group bg-panel-surface rounded-2xl border border-border-subtle overflow-hidden hover:bg-surface-variant/30 hover:border-text-secondary transition-all duration-150 flex flex-col",
                  isInternal ? "" : "target=_blank rel=noopener noreferrer",
                ]}
              >
                <div class="h-48 w-full relative border-b border-border-subtle group-hover:brightness-110 transition-all flex items-center justify-center bg-surface-container-lowest overflow-hidden">
                  {
                    img ? (
                      <img src={img} alt={item.title} class="h-full w-full object-cover" />
                    ) : (
                      <div
                        class="w-full h-full flex items-center justify-center"
                        style={`background: linear-gradient(135deg, ${tColor}33 0%, ${tColor}11 100%);`}
                      >
                        <span class="material-symbols-outlined text-border-subtle text-6xl">newspaper</span>
                      </div>
                    )
                  }
                </div>
                <div class="p-4 flex flex-col gap-2 flex-grow">
                  <div class="flex justify-between items-center text-[10px] font-bold tracking-widest text-text-secondary uppercase">
                    <span class="text-primary">{item.source}</span>
                    {item.date && <span>{timeAgo(item.date)}</span>}
                  </div>
                  {cat && (
                    <span
                      class="self-start px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider border"
                      style={`background: ${(categoryColors[cat] ?? tColor)}22; color: ${categoryColors[cat] ?? tColor}; border-color: ${(categoryColors[cat] ?? tColor)}44;`}
                    >
                      {cat}
                    </span>
                  )}
                  <h3 class="font-display text-xl font-semibold text-text-primary leading-tight uppercase group-hover:text-primary transition-colors line-clamp-3">
                    {item.title}
                  </h3>
                  {item.description && (
                    <p class="text-sm text-text-secondary mt-auto line-clamp-3">{item.description}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ) : null
  }
  
  <div class="mt-6">
    <NewsGrid items={restNews.slice(2)} cols={3} />
  </div>
</Layout>
