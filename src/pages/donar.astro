---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Donar · F-Uno Center" description="Ayudanos a mantener F-Uno Center con una donación.">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 border-b border-border-subtle pb-4">
      <h1 class="font-display text-4xl font-bold text-text-primary uppercase tracking-tighter">Donar</h1>
      <p class="text-text-secondary mt-1">Ayudanos a mantener el sitio funcionando.</p>
    </div>

    <div class="bg-panel-surface border border-border-subtle rounded-2xl p-8 text-center space-y-6">
      <span class="material-symbols-outlined text-6xl text-primary-container">favorite</span>
      <div class="space-y-2">
        <h2 class="font-display text-xl text-text-primary">¿Te gusta F-Uno Center?</h2>
        <p class="text-text-secondary text-sm max-w-md mx-auto">
          Tu donación nos ayuda a cubrir los costos de hosting, dominio y API.
          Cualquier monto suma.
        </p>
      </div>
      <a
        href="https://link.mercadopago.com.ar/aereo.ajeno.baila.mp"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#009ee3] text-white font-bold uppercase tracking-wider text-sm hover:opacity-90 transition-opacity"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
        Donar con Mercado Pago
      </a>
      <p class="text-text-secondary text-xs">
        Alias: <span class="text-text-primary font-mono">aereo.ajeno.baila.mp</span>
      </p>
    </div>
  </div>
</Layout>
