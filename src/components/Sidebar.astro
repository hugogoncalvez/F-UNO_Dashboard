---
const links = [
  { href: "/", label: "Inicio", icon: "dashboard" },
  { href: "/resultados", label: "Resultados", icon: "emoji_events" },
  { href: "/gp-actual", label: "GP Actual", icon: "sports_motorsports", isLive: true },
  { href: "/calendario", label: "Calendario", icon: "calendar_today" },
  { href: "/clasificaciones", label: "Clasificaciones", icon: "leaderboard" },
  { href: "/pilotos", label: "Pilotos", icon: "sports_score" },
  { href: "/noticias", label: "Noticias", icon: "newspaper" },
  { href: "/contacto", label: "Contacto", icon: "mail" },
  { href: "/donar", label: "Donar", icon: "favorite" },
];
---

<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm hidden md:hidden"></div>

<!-- Mobile top bar (replaces Navbar on mobile) -->
<div class="flex md:hidden fixed top-0 left-0 right-0 z-30 h-14 bg-panel-surface border-b border-border-subtle items-center px-4 gap-3">
  <button id="menu-btn" type="button" aria-label="Abrir menú" class="text-on-surface-variant hover:text-primary transition-colors">
    <span class="material-symbols-outlined">menu</span>
  </button>
  <span class="font-display font-bold text-headline-md text-on-surface uppercase tracking-wide">F-Uno Center</span>
</div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-50 h-screen w-72 border-r border-border-subtle bg-panel-surface flex-col py-gutter
    -translate-x-full transition-transform duration-200 md:translate-x-0 md:flex"
>
  <div class="px-6 mb-8 flex flex-col gap-1">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo.webp" alt="F-Uno Center Logo" class="w-20 h-20 rounded-xl shrink-0 object-center p-2 bg-gradient-to-br from-primary-container/60 to-carbon-bg border border-primary-container/40 shadow-[0_0_20px_4px_rgba(225,6,0,0.45)]" />
      <span class="font-display text-display-lg font-bold text-primary-container uppercase tracking-tighter leading-none">
        F-Uno Center
      </span>
    </a>
    <span class="font-label-caps text-label-caps text-text-secondary ml-24">Digital Paddock</span>
  </div>
  <nav class="flex-1 flex flex-col gap-1 px-2 overflow-y-auto">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "flex items-center gap-3 px-4 py-3 rounded-lg transition-transform duration-150 scale-102 active:scale-98 relative",
            Astro.url.pathname === link.href
              ? "text-primary-container font-bold bg-surface-container-low border-l-4 border-primary-container rounded-l-none"
              : "text-text-secondary font-medium hover:text-on-surface hover:bg-surface-container-high",
          ]}
        >
          <span class="material-symbols-outlined" style={Astro.url.pathname === link.href ? "font-variation-settings: \"FILL\" 1;" : ""}>
            {link.icon}
          </span>
          <span class="font-label-caps text-label-caps flex-1">{link.label}</span>
          {link.isLive && (
            <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          )}
        </a>
      ))
    }
  </nav>
  <div class="mt-auto px-4 pt-4 border-t border-border-subtle">
    <p class="font-label-caps text-[10px] text-text-secondary uppercase leading-5">
      Datos: OpenF1 · Jolpica-F1<br />
      Proyecto independiente
    </p>
  </div>
</aside>

<script>
  const btn = document.getElementById("menu-btn");
  const sidebar = document.getElementById("sidebar");
  const backdrop = document.getElementById("sidebar-backdrop");

  function closeSidebar() {
    sidebar?.classList.add("-translate-x-full");
    backdrop?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", () => {
    const open = sidebar?.classList.contains("-translate-x-full") ?? true;
    sidebar?.classList.toggle("-translate-x-full");
    backdrop?.classList.toggle("hidden");
    document.body.style.overflow = open ? "hidden" : "";
  });

  backdrop?.addEventListener("click", closeSidebar);
  sidebar?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeSidebar));
</script>