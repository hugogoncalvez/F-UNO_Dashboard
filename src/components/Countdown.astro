---
interface Props {
  target: string;
}

const { target } = Astro.props;
---

<div id="countdown" data-target={target} class="flex gap-3 sm:gap-4 flex-wrap sm:flex-nowrap">
  <div class="flex flex-col items-center">
    <div class="bg-surface-container rounded-lg border border-border-subtle w-16 h-14 sm:w-16 sm:h-16 flex items-center justify-center font-data-tabular text-2xl text-on-surface" data-unit="d">--</div>
    <span class="font-label-caps text-label-caps text-on-surface-variant mt-2">DÍAS</span>
  </div>
  <div class="flex flex-col items-center">
    <div class="bg-surface-container rounded-lg border border-border-subtle w-16 h-14 sm:w-16 sm:h-16 flex items-center justify-center font-data-tabular text-2xl text-on-surface" data-unit="h">--</div>
    <span class="font-label-caps text-label-caps text-on-surface-variant mt-2">HRS</span>
  </div>
  <div class="flex flex-col items-center">
    <div class="bg-surface-container rounded-lg border border-border-subtle w-16 h-14 sm:w-16 sm:h-16 flex items-center justify-center font-data-tabular text-2xl text-on-surface" data-unit="m">--</div>
    <span class="font-label-caps text-label-caps text-on-surface-variant mt-2">MIN</span>
  </div>
  <div class="flex flex-col items-center">
    <div class="bg-surface-container rounded-lg border border-border-subtle w-16 h-14 sm:w-16 sm:h-16 flex items-center justify-center font-data-tabular text-2xl text-primary-container" data-unit="s">--</div>
    <span class="font-label-caps text-label-caps text-on-surface-variant mt-2">SEG</span>
  </div>
</div>

<script>
  const el = document.getElementById("countdown")!;
  const target = new Date(el.dataset.target ?? "").getTime();
  const days = el.querySelector('[data-unit="d"]')!;
  const hours = el.querySelector('[data-unit="h"]')!;
  const mins = el.querySelector('[data-unit="m"]')!;
  const secs = el.querySelector('[data-unit="s"]')!;

  function tick() {
    let diff = Math.max(0, target - Date.now());
    const d = Math.floor(diff / 86400000);
    diff -= d * 86400000;
    const h = Math.floor(diff / 3600000);
    diff -= h * 3600000;
    const m = Math.floor(diff / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    days.textContent = String(d);
    hours.textContent = String(h).padStart(2, "0");
    mins.textContent = String(m).padStart(2, "0");
    secs.textContent = String(s).padStart(2, "0");
  }

  tick();
  setInterval(tick, 1000);
</script>