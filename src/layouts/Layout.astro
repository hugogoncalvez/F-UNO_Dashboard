---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
// import LiveTicker from "../components/LiveTicker.astro"; // Oculto temporalmente (direcciona al Centro de Control)
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  schema?: Record<string, any>;
}

const { title, description, image, canonical, schema } = Astro.props;
const siteUrl = "https://f-uno-center.vercel.app";
const pageTitle = title ?? "F-Uno Center";
const pageDescription = description ?? "Dashboard de Formula 1: calendario, clasificaciones, resultados, pilotos y noticias.";
const pageImage = image ?? "/og-default.svg";
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;

const pathSegments = Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl }
];
const pageNames: Record<string, string> = {
  "noticias": "Noticias",
  "pilotos": "Pilotos",
  "calendario": "Calendario",
  "resultados": "Resultados",
  "clasificaciones": "Clasificaciones",
  "gp-actual": "GP Actual",
  "contacto": "Contacto",
  "donar": "Donar",
};
pathSegments.forEach((seg, i) => {
  const name = pageNames[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1);
  breadcrumbItems.push({
    "@type": "ListItem",
    position: i + 2,
    name,
    ...(i < pathSegments.length - 1 ? { item: `${siteUrl}/${seg}` } : {})
  });
});
const autoBreadcrumbSchema = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
} : null;
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="16" fill="#e10600"/><text x="50" y="72" font-size="60" font-family="Arial" font-weight="bold" fill="#fff" text-anchor="middle">F1</text></svg>`,
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}${pageImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="F-Uno Center" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}${pageImage}`} />

    <!-- Schema.org WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "F-Uno Center",
      "url": siteUrl,
      "description": "Dashboard de Formula 1: calendario, clasificaciones, resultados, pilotos y noticias.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/noticias?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Page-specific schema -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Auto BreadcrumbList -->
    {autoBreadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(autoBreadcrumbSchema)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col selection:bg-primary-container selection:text-on-primary-container">
    <Sidebar />
    <div class="flex-1 flex flex-col min-h-screen md:pl-72 w-full pt-14 md:pt-0">
      <!-- <LiveTicker /> --> <!-- Ticker LIVE oculto temporalmente -->
      <main class="flex-1 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>